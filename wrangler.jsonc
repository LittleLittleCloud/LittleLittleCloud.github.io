{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "littlelittlecloud",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Static output of `next build` (next.config.mjs sets output: "export")
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only API requests invoke the Worker; all other paths are served straight from assets
    "run_worker_first": ["/api/*"]
  },
  // workers.dev URL for production, plus per-version / per-PR preview URLs
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview` (Workers Builds preview command). Previews inherit
  // assets, compatibility settings and bindings from the top-level config.
  "previews": {},
  "observability": { "enabled": true }
}
